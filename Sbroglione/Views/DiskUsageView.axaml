<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="https://github.com/projektanker/icons.avalonia"
             xmlns:views="clr-namespace:Sbroglione.Views"
             x:Class="Sbroglione.Views.DiskUsageView">

  <DockPanel>

    <!-- Header piatto -->
    <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.Card}"
            BorderBrush="{DynamicResource Brush.CardBorder}" BorderThickness="0,0,0,1" Padding="20,14">
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <i:Icon Value="fa-solid fa-chart-pie" FontSize="20" Foreground="{DynamicResource Brush.Accent}" />
        <TextBlock Text="{DynamicResource Str.Nav.DiskUsage}" FontSize="18" FontWeight="Bold"
                   Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center" />
      </StackPanel>
    </Border>

    <!-- Barra comandi -->
    <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.Surface}" Padding="20,12">
      <DockPanel>
        <Button DockPanel.Dock="Left" Classes="iconbtn" Margin="0,0,8,8"
                i:Attached.Icon="fa-solid fa-arrow-up"
                Command="{Binding NavigateUpCommand}"
                IsEnabled="{Binding CanNavigateUp}" />
        <WrapPanel x:Name="CommandWrap" DockPanel.Dock="Right" HorizontalAlignment="Right">
          <Button Classes="iconbtn" Margin="8,0,0,8"
                  i:Attached.Icon="fa-solid fa-magnifying-glass"
                  Command="{Binding BrowseRootCommand}" />
          <Button Classes="primary" Content="{DynamicResource Str.Common.Analyze}" Margin="8,0,0,8"
                  Command="{Binding ScanCommand}" IsEnabled="{Binding !IsScanning}" />
          <Button Classes="secondary" Content="{DynamicResource Str.Common.Cancel}" Margin="8,0,0,8"
                  Command="{Binding CancelScanCommand}" IsEnabled="{Binding IsScanning}" />
        </WrapPanel>
        <TextBox Margin="0,0,8,8" Text="{Binding RootPath}" IsReadOnly="True"
                 Watermark="{DynamicResource Str.Common.AnalyzeFolderWatermark}" />
      </DockPanel>
    </Border>

    <!-- Stato e percorso corrente -->
    <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.Surface}" Padding="20,0,20,8">
      <StackPanel Spacing="2">
        <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource Brush.TextMuted}" />
        <TextBlock Text="{Binding CurrentPathText}" FontSize="11"
                   Foreground="{DynamicResource Brush.TextMuted}" />
      </StackPanel>
    </Border>

    <!-- Lista gerarchica con barre inline -->
    <Border Background="{DynamicResource Brush.Surface}" Padding="20,0,20,20">
      <views:HierarchyListControl x:Name="HierarchyList" Node="{Binding CurrentNode}" />
    </Border>
  </DockPanel>

</UserControl>
