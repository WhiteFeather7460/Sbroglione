<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="https://github.com/projektanker/icons.avalonia"
             xmlns:views="clr-namespace:Sbroglione.Views"
             xmlns:vm="clr-namespace:Sbroglione.ViewModels"
             xmlns:conv="clr-namespace:Sbroglione.Converters"
             x:Class="Sbroglione.Views.MainView"
             x:DataType="vm:MainWindowViewModel"
             Background="{DynamicResource Brush.Surface}">

  <UserControl.Resources>
    <conv:WidthToTabStripPlacementConverter x:Key="WidthToTabStripPlacement" />
  </UserControl.Resources>

  <Grid RowDefinitions="Auto,*,Auto" Name="RootGrid">

    <Border Grid.Row="0" Classes="card" Margin="8" Padding="12"
            IsVisible="{Binding ShowUpdateBanner}">
      <Grid ColumnDefinitions="*,Auto,Auto" VerticalAlignment="Center">

        <TextBlock Grid.Column="0" VerticalAlignment="Center"
                   Text="{Binding UpdateBannerText}"
                   Foreground="{DynamicResource Brush.TextPrimary}"
                   IsVisible="{Binding !IsUpdating}" />

        <ProgressBar Grid.Column="0" VerticalAlignment="Center" Height="8"
                     Minimum="0" Maximum="1" Value="{Binding UpdateProgress}"
                     IsVisible="{Binding IsUpdating}" />

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0"
                    IsVisible="{Binding !IsUpdating}">
          <Button Classes="primary" Content="{DynamicResource Str.Update.Button}"
                  Command="{Binding UpdateCommand}" />
          <Button Classes="secondary" Content="{DynamicResource Str.Update.Dismiss}"
                  Command="{Binding DismissUpdateCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <TabControl Grid.Row="1" Classes="nav" Padding="0"
                TabStripPlacement="{Binding #RootGrid.Bounds.Width, Converter={StaticResource WidthToTabStripPlacement}}">
      <TabItem ToolTip.Tip="{DynamicResource Str.Nav.Copy}">
        <TabItem.Header>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <i:Icon Value="fa-solid fa-copy" />
            <TextBlock Text="{DynamicResource Str.Nav.Copy}" IsVisible="{Binding IsNavExpanded}" />
          </StackPanel>
        </TabItem.Header>
        <views:CopyPairsView />
      </TabItem>
      <TabItem ToolTip.Tip="{DynamicResource Str.Nav.Remote}">
        <TabItem.Header>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <i:Icon Value="fa-solid fa-server" />
            <TextBlock Text="{DynamicResource Str.Nav.Remote}" IsVisible="{Binding IsNavExpanded}" />
          </StackPanel>
        </TabItem.Header>
        <views:RemoteBrowserView />
      </TabItem>
      <TabItem ToolTip.Tip="{DynamicResource Str.Nav.Compare}">
        <TabItem.Header>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <i:Icon Value="fa-solid fa-code-compare" />
            <TextBlock Text="{DynamicResource Str.Nav.Compare}" IsVisible="{Binding IsNavExpanded}" />
          </StackPanel>
        </TabItem.Header>
        <views:ComparisonView />
      </TabItem>
      <TabItem ToolTip.Tip="{DynamicResource Str.Nav.WatchSync}">
        <TabItem.Header>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <i:Icon Value="fa-solid fa-rotate" />
            <TextBlock Text="{DynamicResource Str.Nav.WatchSync}" IsVisible="{Binding IsNavExpanded}" />
          </StackPanel>
        </TabItem.Header>
        <views:WatchFoldersView />
      </TabItem>
      <TabItem ToolTip.Tip="{DynamicResource Str.Nav.Duplicates}">
        <TabItem.Header>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <i:Icon Value="fa-solid fa-clone" />
            <TextBlock Text="{DynamicResource Str.Nav.Duplicates}" IsVisible="{Binding IsNavExpanded}" />
          </StackPanel>
        </TabItem.Header>
        <views:DuplicatesView />
      </TabItem>
      <TabItem ToolTip.Tip="{DynamicResource Str.Nav.DiskUsage}">
        <TabItem.Header>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <i:Icon Value="fa-solid fa-chart-pie" />
            <TextBlock Text="{DynamicResource Str.Nav.DiskUsage}" IsVisible="{Binding IsNavExpanded}" />
          </StackPanel>
        </TabItem.Header>
        <views:DiskUsageView />
      </TabItem>
      <TabItem ToolTip.Tip="{DynamicResource Str.Nav.Settings}">
        <TabItem.Header>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <i:Icon Value="fa-solid fa-gear" />
            <TextBlock Text="{DynamicResource Str.Nav.Settings}" IsVisible="{Binding IsNavExpanded}" />
          </StackPanel>
        </TabItem.Header>
        <views:SettingsView />
      </TabItem>
    </TabControl>

    <Button Grid.Row="2"
            Classes="iconbtn"
            Margin="8 0 0 8"
            HorizontalAlignment="Left"
            ToolTip.Tip="{DynamicResource Str.Nav.ToggleMenu}"
            Command="{Binding ToggleNavCommand}">
      <i:Icon Value="fa-solid fa-bars" />
    </Button>
  </Grid>

</UserControl>
