<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="https://github.com/avaloniaui"
             x:Class="GetStartedApp.Views.View1">


	<StackPanel Margin="10">
		<Button Content="Aggiungi coppia" Command="{Binding AddPairCommand}" Width="150"/>

		<ItemsControl ItemsSource="{Binding PathPairs}">
			<ItemsControl.ItemTemplate>
				<DataTemplate>
					<StackPanel Orientation="Vertical" Margin="0,5">
						<!-- Separatore -->
						<Separator Margin="0,8,0,8"/>
						
						<!-- Source -->
						<Grid ColumnDefinitions="Auto,*" Margin="0,2">
							<Button Grid.Column="0"
									Content="Sfoglia..."
									Margin="0,0,8,0"
									Command="{Binding DataContext.BrowseSourceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
									CommandParameter="{Binding}"/>
							<TextBox Grid.Column="1"
									 Text="{Binding SourcePath}"
									 IsReadOnly="True"
									 HorizontalAlignment="Stretch"/>
						</Grid>
						
						<!-- Destination -->
						<Grid ColumnDefinitions="Auto,*" Margin="0,2">
							<Button Grid.Column="0"
									Content="Sfoglia..."
									Margin="0,0,8,0"
									Command="{Binding DataContext.BrowseDestinationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
									CommandParameter="{Binding}"/>
							<TextBox Grid.Column="1"
									 Text="{Binding DestinationPath}"
									 IsReadOnly="True"
									 HorizontalAlignment="Stretch"/>
						</Grid>

						<!-- Separatore -->
						<Separator Margin="0,5"/>

						<!-- Espandibile: elenco file -->
						<Expander Header="Mostra file da elaborare">
							<DataGrid ItemsSource="{Binding FilesToProcess}"
									  AutoGenerateColumns="True"
									  IsReadOnly="True"
									  MaxHeight="200"
									  Margin="0,5,0,0"/>
						</Expander>
						
						<!-- Comandi per questa riga -->
						<Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
							<!-- Info/Progress a sinistra -->
							<StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
								<ProgressBar Width="180" Height="12"
											 Minimum="0" Maximum="1"
											 Value="{Binding Progress}"/>
								<TextBlock Text="{Binding Status}" VerticalAlignment="Center"/>
							</StackPanel>

							<!-- Pulsanti a destra (legati al ViewModel contenitore) -->
							<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
								<Button Content="Avvia"
										Width="100"
										Command="{Binding DataContext.StartCopyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
										CommandParameter="{Binding}"
										IsEnabled="{Binding CanStart}"/>
								<Button Content="Annulla"
										Width="100"
										Command="{Binding DataContext.CancelCopyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
										CommandParameter="{Binding}"
										IsEnabled="{Binding IsCopying}"/>
							</StackPanel>
						</Grid>
					</StackPanel>
					<!--<StackPanel Orientation="Horizontal" Spacing="10" Margin="0,5">
						<TextBox Text="{Binding SourcePath}" Width="250" IsReadOnly="True"/>
						--><!--<Button Content="Sfoglia..." Command="{Binding DataContext.BrowseSourceCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>--><!--
						<Button Content="Sfoglia..."
								Command="{Binding DataContext.BrowseSourceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
								CommandParameter="{Binding}"/>

						<TextBox Text="{Binding DestinationPath}" Width="250" IsReadOnly="True"/>
						--><!--<Button Content="Sfoglia..." Command="{Binding DataContext.BrowseDestinationCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>--><!--
						<Button Content="Sfoglia..."
								Command="{Binding DataContext.BrowseDestinationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
								CommandParameter="{Binding}"/>
					</StackPanel>-->
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ItemsControl>
	</StackPanel>
	
</UserControl>
